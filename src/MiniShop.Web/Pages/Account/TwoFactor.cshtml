@page
@model MiniShop.Web.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = "Dvoufázové ověření";
}
<h1>Dvoufázové ověření</h1>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (Model.IsRequiredForAdmin)
{
    <div class="alert alert-info" data-track="two-factor-required">
        <strong>Dvoufázové ověření je pro admina povinné.</strong> Dokud ho nenastavíte, správa obchodu
        (produkty, objednávky, uživatelé…) je zamčená. Naskenujte QR kód v aplikaci (Google Authenticator,
        Microsoft Authenticator…) a opište první kód.
    </div>
}

<div class="row">
    <div class="col-md-8 col-lg-7">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (Model.RecoveryCodes is { Count: > 0 })
        {
            <div class="alert alert-warning" data-track="two-factor-recovery-codes">
                <strong>Uložte si záchranné kódy.</strong> Zobrazují se jen teď. Každý jde použít jednou, když nemáte
                telefon. Uložte je na bezpečné místo (správce hesel, vytištěné).
                <ul class="list-unstyled font-monospace mt-2 mb-0">
                    @foreach (var recoveryCode in Model.RecoveryCodes)
                    {
                        <li>@recoveryCode</li>
                    }
                </ul>
            </div>
        }

        @if (Model.IsEnabled)
        {
            <p>Dvoufázové ověření je <strong>zapnuté</strong>. Zbývá vám <strong>@Model.RecoveryCodesLeft</strong> záchranných kódů.</p>

            <form method="post" asp-page-handler="Regenerate" class="mb-4">
                <h2 class="h5">Nové záchranné kódy</h2>
                <p class="text-muted">Staré kódy přestanou platit. Potvrďte aktuálním kódem z aplikace.</p>
                <div class="mb-3">
                    <label for="code-regenerate" class="form-label">Kód z aplikace</label>
                    <input id="code-regenerate" name="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Vytvořit nové záchranné kódy</button>
            </form>

            @if (Model.CanDisable)
            {
                <form method="post" asp-page-handler="Disable">
                    <h2 class="h5">Vypnout dvoufázové ověření</h2>
                    <div class="mb-3">
                        <label for="code-disable" class="form-label">Kód z aplikace</label>
                        <input id="code-disable" name="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Vypnout</button>
                </form>
            }
            else
            {
                <p class="text-muted">Pro správce je dvoufázové ověření povinné – vypnout ho nejde.</p>
            }
        }
        else
        {
            <p class="text-muted">
                Kromě hesla budete při přihlášení zadávat 6místný kód z aplikace v telefonu
                (Google Authenticator, Microsoft Authenticator, Authy…). Ukradené heslo pak samo nestačí.
            </p>
            <ol>
                <li>V aplikaci přidejte nový účet a naskenujte QR kód (nebo opište klíč).</li>
                <li>Opište aktuální 6místný kód a potvrďte.</li>
            </ol>

            <div class="two-factor-qr mb-3" data-track="two-factor-qr">@Html.Raw(Model.QrSvg)</div>
            <p>Klíč k ručnímu zadání: <code data-track="two-factor-key">@Model.SharedKey</code></p>

            <form method="post" asp-page-handler="Enable">
                <div class="mb-3">
                    <label for="code-enable" class="form-label">Kód z aplikace</label>
                    <input id="code-enable" name="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                </div>
                <button type="submit" class="btn btn-primary">Zapnout</button>
            </form>
        }
    </div>
</div>

<partial name="_AccountFooter" />
