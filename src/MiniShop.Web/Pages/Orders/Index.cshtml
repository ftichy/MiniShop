@page
@model MiniShop.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Objednávky";
}
<h1 class="mb-3">Objednávky</h1>


<partial name="_StatusMessage" model="Model.StatusMessage" />
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@* E-shop krok 4B: objednává se přes košík a pokladnu – tady jen přehled objednávek. *@
@if (Model.CanPlaceOrders)
{
    <p><a asp-page="/Shop/Index" class="btn btn-outline-primary btn-sm" data-track="orders-to-shop">Nakupovat v obchodě</a></p>
}
else if (Model.NeedsEmailConfirmation)
{
    @* Účty krok 9: bez potvrzeného e-mailu nejde objednávat (hlídá to i košík, pokladna a API). *@
    <div class="alert alert-info">
        Objednávat můžete, až potvrdíte svůj e-mail – odkaz jsme poslali po registraci,
        nový pošle tlačítko <strong>Poslat znovu</strong> v upozornění nahoře.
    </div>
}

@if (Model.CanManageOrders)
{
    @* E-shop krok 6: balení, odeslání a doručení – vlastní stránka s frontami. *@
    <p><a asp-page="/Admin/Fulfilment/Index" class="btn btn-outline-primary btn-sm" data-track="orders-to-fulfilment">Expedice</a></p>
    <form method="post" asp-page-handler="SyncCatalog" class="mb-4">
        <button type="submit" class="btn btn-link btn-sm p-0">Obnovit katalog ze skladu</button>
        <span class="text-muted small">– když v nabídce chybí produkt, který sklad má</span>
    </form>
}

@* Účty krok 3: zákazník vidí jen své objednávky, admin všechny. *@
<h2 class="h4">@(Model.CanManageOrders ? "Všechny objednávky" : "Moje objednávky")</h2>

@if (Model.Orders.Count == 0)
{
    <p>Zatím žádné objednávky.</p>
}

@if (Model.HasPendingOrders)
{
    @* Krok 9: sklad objednávku ověřuje na pozadí (sága) – za 2 s se podíváme znovu. *@
    <p class="text-muted small" data-reload-when-idle>Některé objednávky čekají na ověření skladu, stránka se sama obnoví…</p>
}

@* Krok 12A: vstupem je číslo objednávky – zobrazí, jak uživatel formulář vyplňoval. Účty krok 2: jen admin. *@
@if (Model.CanManageOrders)
{
    <form method="get" asp-page="/Orders/Journey" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label for="journey-order-id" class="form-label small mb-0">Průběh zakládání objednávky č.</label>
            <input id="journey-order-id" name="orderId" type="number" min="1" class="form-control form-control-sm" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Zobrazit průběh</button>
            @* Krok 12B: stejné číslo, jiná projekce – přehrání. *@
            <button type="submit" formaction="@Url.Page("/Orders/Replay")" class="btn btn-sm btn-outline-primary">▶ Přehrát</button>
        </div>
    </form>
}

@* Vzhled B: objednávka jako karta – hlavička (číslo, datum, stav), položky jako řádky (bez tabulky – na telefonu
   se nic neusekne), dole doprava, celkem a akce. *@
<div class="d-flex flex-column gap-3">
@foreach (var order in Model.Orders)
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <div>
                    @* E-shop krok 5: detail s historií stavů. *@
                    <a asp-page="/Orders/Detail" asp-route-id="@order.Id" class="fw-bold fs-5 text-decoration-none" data-track="order-detail-link">Objednávka č. @order.Id</a>
                    <div class="small text-muted">
                        @order.CreatedAtUtc.ToCzechString()
                        @if (Model.CanManageOrders)
                        {
                            <text>· @order.CustomerName (@order.CustomerEmail)</text>
                        }
                    </div>
                </div>
                <span class="badge @OrderStatusLabels.Badge(order.Status)">@OrderStatusLabels.Text(order.Status, order.ShippingMethod)</span>
            </div>
            @if (order.RejectionReason is not null)
            {
                <div class="alert alert-danger py-2 small mb-2">@order.RejectionReason</div>
            }
            <ul class="list-unstyled small mb-2">
                @foreach (var item in order.Items)
                {
                    <li class="d-flex justify-content-between gap-3 py-1 border-bottom">
                        <span class="min-w-0">@item.Quantity× @item.ProductName
                            @if (item.Discount > 0)
                            {
                                <span class="text-success">(sleva -@item.Discount.ToString("N2") Kč)</span>
                            }
                        </span>
                        <span class="text-nowrap">@item.LineTotal.ToString("N2") Kč</span>
                    </li>
                }
                @* E-shop krok 4: doprava z pokladny (starší objednávky a objednávky přes API ji nemají). *@
                @if (order.ShippingMethod != "None")
                {
                    <li class="d-flex justify-content-between gap-3 py-1 border-bottom text-muted">
                        <span class="min-w-0">
                            Doprava: @(order.ShippingMethod == "Courier" ? "kurýr" : "osobní odběr")
                            @if (order.DeliveryAddress is not null)
                            {
                                <span>– @order.DeliveryAddress</span>
                            }
                        </span>
                        <span class="text-nowrap">@(order.ShippingPrice == 0 ? "zdarma" : $"{order.ShippingPrice:N2} Kč")</span>
                    </li>
                }
            </ul>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div><span class="text-muted small">Celkem</span> <strong class="ms-1">@order.TotalPrice.ToString("N2") Kč</strong></div>
                <div class="d-flex flex-wrap gap-1">
                    @if (Model.CanManageOrders)
                    {
                        <a asp-page="/Orders/Journey" asp-route-orderId="@order.Id" class="btn btn-sm btn-link">Průběh zadání</a>
                        <a asp-page="/Orders/Replay" asp-route-orderId="@order.Id" asp-route-autoplay="1" class="btn btn-sm btn-link">▶ Přehrát</a>
                    }
                    <a asp-page="/Orders/Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Detail</a>
                    @* E-shop krok 6: „Vyřídit“ nahradila stránka Expedice; zrušit jde i během balení. *@
                    @if (OrderStatusLabels.CanCancel(order.Status))
                    {
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@order.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Zrušit</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
    @* Účty krok 8: obnovení stránky ze souboru (CSP nepustí inline skript). *@
    <script src="~/js/orders-reload.js" asp-append-version="true"></script>
}
