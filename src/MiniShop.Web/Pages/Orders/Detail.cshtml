@page "/Orders/{id:int}"
@model MiniShop.Web.Pages.Orders.DetailModel
@{
    ViewData["Title"] = $"Objednávka č. {Model.Order.Id}";
    var order = Model.Order;
}
<p><a asp-page="/Orders/Index" data-track="order-detail-back">← Objednávky</a></p>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Objednávka č. @order.Id</h1>
    <span class="badge fs-6 @OrderStatusLabels.Badge(order.Status)" data-track="order-detail-status">@OrderStatusLabels.Text(order.Status, order.ShippingMethod)</span>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (order.Status == "Pending")
{
    @* Krok 9: sklad objednávku ověřuje na pozadí (sága) – stránka se za 2 s sama obnoví. *@
    <p class="text-muted small" data-reload-when-idle>Čekáme na potvrzení skladu, stránka se sama obnoví…</p>
}
else if (order.Status == "AwaitingPayment")
{
    @* E-shop krok 8: zboží drží rezervace, zákazník má na zaplacení omezený čas (pak sága objednávku zamítne).
       Stránka se obnovuje – po zaplacení (třeba v jiné záložce) se ukáže potvrzení. *@
    <div class="alert alert-warning d-flex justify-content-between align-items-center" data-reload-when-idle>
        <span>Zboží máme rezervované. Zaplaťte prosím kartou do @Model.PaymentMinutes minut od rezervace, jinak objednávku zrušíme.</span>
        @if (!Model.CanManageOrders)
        {
            <a asp-page="/Pay/Index" asp-route-orderId="@order.Id" class="btn btn-primary" data-track="order-pay">Zaplatit @order.TotalPrice.ToString("N2") Kč</a>
        }
    </div>
}
else if (order.Status == "ReturnRequested")
{
    @* E-shop krok 12: sága vratky čeká na zboží – pak sklad naskladní a Payments vrátí peníze (stránka se obnovuje). *@
    <div class="alert alert-info" data-reload-when-idle data-track="order-return-pending">
        Čekáme na vrácené zboží – pošlete ho na adresu <strong>MiniShop, Skladová 1, 110 00 Praha</strong>
        (termín najdete v e-mailu). Peníze vrátíme, jakmile zásilku převezmeme.
        @if (Model.Detail.ReturnReason is not null)
        {
            <div class="small mt-1">Důvod vrácení: @Model.Detail.ReturnReason</div>
        }
    </div>
}
else if (order.Status == "Returned")
{
    <div class="alert alert-secondary">
        Objednávka je vrácená – zboží jsme převzali.
        @(order.PaymentMethod == "Card" ? "Peníze jsme vrátili na kartu." : "Peníze posíláme převodem.")
    </div>
}
else if (order.Status == "Completed" && Model.Detail.ReturnRejectionReason is not null)
{
    <div class="alert alert-secondary">Vrácení nebylo přijato: @Model.Detail.ReturnRejectionReason</div>
}

<p class="text-muted">
    @order.CustomerName@(string.IsNullOrEmpty(order.CustomerEmail) ? "" : $" ({order.CustomerEmail})"),
    objednáno @order.CreatedAtUtc.ToLocalTime().ToString("g")
</p>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5">Položky</h2>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th class="num">Cena/ks</th>
                    <th class="num">Množství</th>
                    <th class="num">Sleva</th>
                    <th class="num">Celkem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in order.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="num">@item.UnitPrice.ToString("N2") Kč</td>
                        <td class="num">@item.Quantity</td>
                        <td class="num">@(item.Discount > 0 ? $"-{item.Discount:N2} Kč" : "")</td>
                        <td class="num">@item.LineTotal.ToString("N2") Kč</td>
                    </tr>
                }
                @if (order.ShippingMethod != "None")
                {
                    <tr>
                        <td colspan="4">Doprava: @(order.ShippingMethod == "Courier" ? "kurýr" : "osobní odběr")</td>
                        <td class="num">@(order.ShippingPrice == 0 ? "zdarma" : $"{order.ShippingPrice:N2} Kč")</td>
                    </tr>
                }
                @if (order.CouponCode is not null)
                {
                    @* E-shop krok 13: sleva z kódu je rozpočítaná ve slevách položek – tady jen pro informaci. *@
                    <tr class="text-muted small">
                        <td colspan="4">Slevový kód @order.CouponCode (už ve slevách položek)</td>
                        <td class="num">-@order.CouponDiscount.ToString("N2") Kč</td>
                    </tr>
                }
                <tr class="fw-bold">
                    <td colspan="4">Celkem</td>
                    <td class="num">@order.TotalPrice.ToString("N2") Kč</td>
                </tr>
            </tbody>
        </table>

        @if (order.ShippingMethod == "Courier")
        {
            <h2 class="h5">Doručovací adresa</h2>
            @* Účty krok 9: po smazání účtu je adresa anonymizovaná (null). *@
            <p>@(order.DeliveryAddress ?? "adresa byla smazána")</p>
        }
        @if (order.PaymentMethod != "None")
        {
            @* E-shop krok 8 *@
            <h2 class="h5">Platba</h2>
            <p>@(order.PaymentMethod == "Card" ? "Kartou online" : "Dobírka – platba při převzetí")</p>
        }
        @if (order.Carrier is not null)
        {
            @* E-shop krok 6: vyplní admin při odeslání. *@
            <h2 class="h5">Zásilka</h2>
            <p data-track="order-detail-tracking">@order.Carrier@(order.TrackingNumber is null ? "" : $", číslo zásilky {order.TrackingNumber}")</p>
        }
        else if (order.ShippingMethod == "Pickup")
        {
            <h2 class="h5">Doprava</h2>
            <p>Osobní odběr na prodejně.</p>
        }
    </div>

    <div class="col-lg-5">
        @* E-shop krok 5: historie stavů – jako sledování zásilky, nejstarší nahoře. *@
        <h2 class="h5">Průběh objednávky</h2>
        <ol class="list-group list-group-numbered mb-3" data-track="order-detail-history">
            @foreach (var change in Model.Detail.History)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-semibold">@OrderStatusLabels.HistoryText(change.Status, order.ShippingMethod)</div>
                        @if (change.Note is not null)
                        {
                            @* Důvod zamítnutí (červeně), od e-shop kroku 6 i dopravce a číslo zásilky. *@
                            <div class="small @(change.Status == "Rejected" ? "text-danger" : "text-muted")">@change.Note</div>
                        }
                        <div class="small text-muted">@DetailModel.FormatTime(change.ChangedAtUtc)</div>
                    </div>
                    <span class="badge @OrderStatusLabels.Badge(change.Status)">@OrderStatusLabels.Text(change.Status, order.ShippingMethod)</span>
                </li>
            }
        </ol>

        @* E-shop krok 6 a 9: zrušit jde kdykoli před odesláním (i během čekání na sklad nebo platbu). Handler i kontrola práv jsou na stránce
           Objednávky (zákazník ruší jen svou); balení a odeslání má admin na stránce Expedice. *@
        @if (OrderStatusLabels.CanCancel(order.Status))
        {
            <form method="post" asp-page="/Orders/Index" asp-page-handler="Cancel" asp-route-id="@order.Id">
                <button type="submit" class="btn btn-outline-danger btn-sm">Zrušit objednávku</button>
            </form>
        }

        @if (Model.Detail.ReturnableUntilUtc is { } returnableUntil && !Model.CanManageOrders)
        {
            @* E-shop krok 12: vrátit jde doručenou objednávku do 14 dní a jen jednou (pravidlo hlídá Order.RequestReturn). *@
            <details class="mt-3" data-track="order-return">
                <summary class="btn btn-outline-secondary btn-sm">Vrátit zboží</summary>
                <form method="post" asp-page-handler="Return" asp-route-id="@order.Id" class="mt-2">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <label for="returnReason" class="form-label small">Proč zboží vracíte?</label>
                    <textarea id="returnReason" name="reason" class="form-control form-control-sm mb-2" rows="2"
                              maxlength="500" required data-track="order-return-reason"></textarea>
                    <div class="form-text mb-2">
                        Vrátit můžete do @returnableUntil.ToLocalTime().ToString("d. M. yyyy"). Celou objednávku, peníze vrátíme
                        po převzetí zboží.
                    </div>
                    <button type="submit" class="btn btn-secondary btn-sm" data-track="order-return-submit">Požádat o vrácení</button>
                </form>
            </details>
        }

        @if (Model.CanManageOrders)
        {
            <p class="mt-3 small">
                <a asp-page="/Admin/Fulfilment/Index">Expedice</a> ·
                <a asp-page="/Orders/Journey" asp-route-orderId="@order.Id">Průběh zadání</a> ·
                <a asp-page="/Orders/Replay" asp-route-orderId="@order.Id" asp-route-autoplay="1">▶ Přehrát</a>
            </p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/orders-reload.js" asp-append-version="true"></script>
}
