<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Služba Ordering (krok 10B): REST API objednávek + UI (Razor Pages) pro celý e-shop. Zde se skládá DI (composition root).
       Produkty a zásoby čte z MiniShop.Inventory.Api přes HTTP, rezervace jde přes RabbitMQ. -->
  <PropertyGroup>
    <!-- Účty krok 10: lokálně OAuth klient Googlu v user secrets (dotnet user-secrets set … v src/MiniShop.Web). -->
    <UserSecretsId>4f2d9c71-8a3e-4b6d-9e15-6c0a7b3d2e84</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiniShop.Application\MiniShop.Application.csproj" />
    <ProjectReference Include="..\MiniShop.Infrastructure\MiniShop.Infrastructure.csproj" />
    <ProjectReference Include="..\MiniShop.ServiceDefaults\MiniShop.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <!-- Příručka (/Docs): Markdown z docs/prirucka se kopíruje vedle DLL do složky prirucka – při buildu i do image. -->
  <ItemGroup>
    <Content Include="..\..\docs\prirucka\**\*.md" LinkBase="prirucka" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
