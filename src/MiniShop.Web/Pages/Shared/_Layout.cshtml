@using Microsoft.AspNetCore.Authorization
@using MiniShop.Web.Accounts
@using MiniShop.Web.Extensions
@inject IAuthorizationService AuthorizationService
@{
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.RequireAdmin)).Succeeded;
    // Účty krok 12B: v nabídce Správa jen oblasti, na které má uživatel roli (server to hlídá stejnými politikami).
    var allowed = new HashSet<string>();
    if (isAdmin)
    {
        foreach (var policy in StaffPolicies.Roles.Keys)
        {
            if ((await AuthorizationService.AuthorizeAsync(User, policy)).Succeeded)
            {
                allowed.Add(policy);
            }
        }
    }

    var canCatalogMenu = allowed.Contains(AuthorizationPolicies.RequireStock) || allowed.Contains(AuthorizationPolicies.RequireFulfilment)
        || allowed.Contains(AuthorizationPolicies.RequireReturns) || allowed.Contains(AuthorizationPolicies.RequireMarketing)
        || allowed.Contains(AuthorizationPolicies.RequireSupport);
    var canReportsMenu = allowed.Contains(AuthorizationPolicies.RequireAccounting) || allowed.Contains(AuthorizationPolicies.RequireInvoices)
        || allowed.Contains(AuthorizationPolicies.RequireMarketing);
    var canOperationsMenu = allowed.Contains(AuthorizationPolicies.RequireUserAdmin) || allowed.Contains(AuthorizationPolicies.RequireOperations);
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    // Účty krok 12C: zaměstnanec bez dvoufázového ověření – správa je zamčená, ukážeme cestu k nastavení.
    var needsTwoFactor = isSignedIn && User.NeedsTwoFactorSetup();
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    @* Vzhled krok D: viewport-fit=cover – na iPhonu stránka až k okrajům displeje, spodní lišta si odsadí „bradu“ (safe-area). *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @* Vzhled krok E: barva lišty telefonu podle světlého/tmavého systému; při ruční volbě ji přepíše theme.js. *@
    <meta name="theme-color" content="#4f46e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161b26" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    @* Vzhled krok F1: htmx bez eval a inline skriptů (CSP), jen požadavky na vlastní web, bez vkládaných stylů. *@
    <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"selfRequestsOnly":true,"historyCacheSize":0}' />
    @* Vzhled krok E: tmavý režim – nastaví data-bs-theme dřív, než se stránka vykreslí (proto v hlavičce a bez defer). *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @* Vzhled krok D: instalovatelná aplikace (PWA) – manifest = jméno, ikony, spuštění bez lišty prohlížeče. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MiniShop" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>@ViewData["Title"] – MiniShop</title>
    @* Účty krok 8: Bootstrap 5.3.3 lokálně (ne z CDN) – CSP pouští jen vlastní soubory a cizí server nevidí návštěvníky. *@
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    @* asp-append-version: adresa nese otisk obsahu (?v=…) – po nasazení prohlížeč nepoužije starý soubor z cache. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* Redesign A: hlavička – na mobilu logo, košík a „hamburger“, odkazy se rozbalí pod ní (Bootstrap collapse). *@
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg" aria-label="Hlavní menu">
            <div class="container">
                @* data-track = stabilní jméno prvku pro sledování a přehrávání průběhu objednávky (krok 12). *@
                <a class="navbar-brand me-lg-4" asp-page="/Index" data-track="nav-home">
                    <span class="brand-mark">@Icons.Bag</span> MiniShop
                </a>

                <div class="collapse navbar-collapse order-last order-lg-0" id="main-nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Shop/Index" data-track="nav-shop">Obchod</a></li>
                        @if (isSignedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Orders/Index" data-track="nav-orders">Objednávky</a></li>
                        }
                        @* Účty krok 2: menu podle role – zamčené je to stejně na serveru, tady jde jen o to neukazovat slepé odkazy.
                           Redesign A: administrace v jedné rozbalovací nabídce (11 odkazů by se do lišty nevešlo). *@
                        @if (needsTwoFactor)
                        {
                            <li class="nav-item"><a class="nav-link" href="@AccountsServiceCollectionExtensions.TwoFactorSetupPath" data-track="nav-admin-2fa">Správa</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-track="nav-admin">Správa</a>
                                <ul class="dropdown-menu">
                                    @if (canCatalogMenu)
                                    {
                                        <li><h6 class="dropdown-header">Katalog a objednávky</h6></li>
                                        @if (allowed.Contains(AuthorizationPolicies.RequireStock))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Products/Index" data-track="nav-products">Produkty</a></li>
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireFulfilment))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Fulfilment/Index" data-track="nav-fulfilment">Expedice</a></li>
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireReturns))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Returns/Index" data-track="nav-returns">Vratky</a></li>   @* e-shop krok 12 *@
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireMarketing))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Coupons/Index" data-track="nav-coupons">Kupony</a></li>   @* e-shop krok 13 *@
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireSupport))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Reviews/Index" data-track="nav-reviews">Hodnocení</a></li>   @* e-shop krok 14 *@
                                        }
                                    }
                                    @if (canReportsMenu)
                                    {
                                        @if (canCatalogMenu)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                        }
                                        <li><h6 class="dropdown-header">Přehledy</h6></li>
                                        @if (allowed.Contains(AuthorizationPolicies.RequireAccounting))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Sales/Index" data-track="nav-sales">Tržby</a></li>   @* e-shop krok 11 *@
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireInvoices))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Invoices/Index" data-track="nav-invoices">Faktury</a></li>   @* e-shop krok 15 *@
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireMarketing))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/CartInsights/Index" data-track="nav-cart-insights">Košíky</a></li>   @* e-shop krok 17 *@
                                        }
                                    }
                                    @if (canOperationsMenu)
                                    {
                                        @if (canCatalogMenu || canReportsMenu)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                        }
                                        <li><h6 class="dropdown-header">Provoz</h6></li>
                                        @if (allowed.Contains(AuthorizationPolicies.RequireUserAdmin))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Users/Index" data-track="nav-users">Uživatelé</a></li>
                                        }
                                        @if (allowed.Contains(AuthorizationPolicies.RequireOperations))
                                        {
                                            <li><a class="dropdown-item" asp-page="/Admin/Messages/Index" data-track="nav-messages">Zprávy</a></li>   @* EDA krok 13 *@
                                        }
                                    }
                                </ul>
                            </li>
                        }
                        <li class="nav-item"><a class="nav-link" href="/Docs" data-track="nav-docs">Dokumentace</a></li>
                    </ul>
                    @* Redesign A: hledání přímo z hlavičky – stejný formulář GET jako na stránce Obchod (/Shop?q=…). *@
                    <form class="header-search search-suggest my-2 my-lg-0 me-lg-3 flex-grow-1" method="get" action="/Shop" role="search">
                        <div class="input-group">
                            <span class="input-group-text">@Icons.Search</span>
                            <input class="form-control border-start-0" type="search" name="q" placeholder="Hledat zboží…" aria-label="Hledat zboží" maxlength="100" data-track="nav-search"
                                   data-suggest="@Url.Content("~/api/catalog/suggest")" autocomplete="off" />
                        </div>
                    </form>
                    <partial name="_LoginPartial" />
                </div>

                <div class="d-flex align-items-center gap-1 ms-auto ms-lg-0">
                    @* Vzhled krok F1: obal s id – po „Do košíku“ ho htmx vymění (partial _CartAddResult). *@
                    <div id="cart-badge" class="htmx-region">@await Component.InvokeAsync("CartBadge")</div>
                    <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                            aria-controls="main-nav" aria-expanded="false" aria-label="Otevřít menu" data-track="nav-toggle">
                        @Icons.Menu
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pt-4">
        <partial name="_EmailConfirmationBanner" />
        @if (needsTwoFactor)
        {
            @* Účty krok 12C: bez 2FA by zaměstnanec správu vůbec neviděl a nevěděl proč. *@
            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" data-track="two-factor-required">
                <span>Máte zaměstnaneckou roli – pro přístup do správy si nastavte <strong>dvoufázové ověření</strong>.</span>
                <a class="btn btn-sm btn-warning" href="@AccountsServiceCollectionExtensions.TwoFactorSetupPath">Nastavit</a>
            </div>
        }
        @RenderBody()
    </main>

    @* Účty krok 9: veřejný web – informace o osobních údajích musí být dostupná odkudkoli. *@
    <footer class="site-footer mt-5 py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 small">
            <div><strong class="text-body">MiniShop</strong> – výukový e-shop · platby jen v testovacím režimu</div>
            <nav class="d-flex flex-wrap gap-3" aria-label="Patička">
                <a asp-page="/Shop/Index">Obchod</a>
                <a asp-page="/Privacy" data-track="nav-privacy">Ochrana osobních údajů</a>
                <a href="/Docs">Dokumentace</a>
                <a href="https://github.com/ftichy/MiniShop">Zdrojový kód</a>
            </nav>
        </div>
        @* Vzhled krok D: nabídka instalace – tlačítko ukáže pwa.js, jen když ji prohlížeč umí (Android/Chrome/Edge);
           na iPhonu instalace tlačítkem nejde, ukáže se návod. *@
        <div class="container small mt-2 d-flex flex-wrap align-items-center gap-3">
            @* Vzhled krok E: vzhled stránky – volbu si pamatuje prohlížeč (theme.js); bez JavaScriptu zůstane světlý. *@
            <div class="theme-switch d-flex align-items-center gap-2" data-track="theme-switch">
                <span class="text-body-secondary">Vzhled:</span>
                <div class="btn-group" role="group" aria-label="Vzhled stránky">
                    <button type="button" class="btn btn-outline-secondary" data-theme-choice="auto" aria-pressed="false" data-track="theme-auto">Automaticky</button>
                    <button type="button" class="btn btn-outline-secondary" data-theme-choice="light" aria-pressed="false" data-track="theme-light">Světlý</button>
                    <button type="button" class="btn btn-outline-secondary" data-theme-choice="dark" aria-pressed="false" data-track="theme-dark">Tmavý</button>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" data-pwa-install data-track="pwa-install" hidden>Nainstalovat aplikaci</button>
            <span class="text-body-secondary" data-pwa-ios-hint hidden>Aplikace na iPhonu: v Safari klepněte na <strong>Sdílet</strong> → <strong>Přidat na plochu</strong>.</span>
        </div>
    </footer>
    <partial name="_TabBar" />
    @* Vzhled krok F1: hláška po přidání do košíku (vyplní htmx, ukáže js/cart-add.js) – dole, ať je vidět i po odscrollování. *@
    <div class="toast-container cart-toast-container position-fixed start-50 translate-middle-x p-3">
        <div id="cart-toast"></div>
    </div>
    @* Redesign A: Bootstrap JS lokálně (menu na mobilu, rozbalovací nabídky, panel filtrů) – soubor, ne inline skript (CSP). *@
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @* Stránkování seznamů: výběr velikosti stránky odešle formulář (partial _Pager). *@
    <script src="~/js/pager.js" asp-append-version="true"></script>
    <script src="~/js/search-suggest.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @* Vzhled krok F1: částečné obnovení stránky (formulář na pozadí, výměna kousku HTML) – lokálně, ne z CDN. *@
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/cart-add.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
