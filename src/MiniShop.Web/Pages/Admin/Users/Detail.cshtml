@page "{id}"
@model MiniShop.Web.Pages.Admin.Users.DetailModel
@{
    ViewData["Title"] = Model.Account.DisplayName;
    var account = Model.Account;
}
<p><a asp-page="/Admin/Users/Index">← Uživatelé</a></p>
<partial name="_AdminHeader" model='new MiniShop.Web.Ui.AdminHeaderModel(account.DisplayName, "Uživatelé", "/Admin/Users/Index")' />

<partial name="_StatusMessage" model="Model.StatusMessage" />
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@account.Email @(account.EmailConfirmed ? "(potvrzený)" : "(nepotvrzený)")</dd>
    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9"><partial name="_RoleBadge" model="account.Roles" /></dd>
    <dt class="col-sm-3">Stav</dt>
    <dd class="col-sm-9"><partial name="_LockBadge" model="account" /></dd>
    @* Účty krok 10: heslo, Google – změnit to může jen uživatel sám. *@
    <dt class="col-sm-3">Přihlášení</dt>
    <dd class="col-sm-9">@(Model.SignInMethods.Count > 0 ? string.Join(", ", Model.SignInMethods) : "žádné (jen přes zapomenuté heslo)")</dd>
</dl>

@if (Model.CanManageRoles)
{
    @* Účty krok 12A: role zaškrtávátky – víc najednou, i sám sobě (třeba Zákazník). Zaměstnanecké role vyžadují 2FA. *@
    <form method="post" asp-page-handler="Roles" asp-route-id="@account.Id" class="card card-body mb-4" data-track="user-roles-form">
        <h2 class="h6">Role</h2>
        <div class="row row-cols-1 row-cols-md-2 g-1 mb-2">
            @foreach (var role in MiniShop.Infrastructure.Accounts.AccountRoles.All)
            {
                var disabled = Model.IsCurrentUser && role == MiniShop.Infrastructure.Accounts.AccountRoles.UserAdmin;
                <div class="col">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="roles" value="@role" id="role-@role"
                               checked="@account.Roles.Contains(role)" disabled="@disabled" data-track="user-role-@role" />
                        <label class="form-check-label" for="role-@role">@MiniShop.Infrastructure.Accounts.AccountRoles.Label(role)</label>
                    </div>
                    @if (disabled)
                    {
                        @* Zakázané pole se neposílá – role správce uživatelů musí zůstat (sám si ji odebrat nesmí). *@
                        <input type="hidden" name="roles" value="@role" />
                    }
                </div>
            }
        </div>
        <div class="form-text mb-2">
            Zaměstnanecké role (všechny kromě Zákazníka) vyžadují dvoufázové ověření. O změně dostane uživatel e-mail.
        </div>
        <div><button type="submit" class="btn btn-primary btn-sm" data-track="user-roles-save">Uložit role</button></div>
    </form>
}

@if (Model.IsCurrentUser)
{
    <p class="text-muted">To jste vy – zablokovat se sami nemůžete.</p>
}
else
{
    <div class="d-flex gap-2 mb-4">
        @if (account.IsBlocked || account.LockedOutUntil is not null)
        {
            <form method="post" asp-page-handler="Unlock" asp-route-id="@account.Id">
                <button type="submit" class="btn btn-outline-success">@(account.IsBlocked ? "Odblokovat" : "Zrušit dočasný zámek")</button>
            </form>
        }
        @if (!account.IsBlocked)
        {
            <form method="post" asp-page-handler="Lock" asp-route-id="@account.Id">
                <button type="submit" class="btn btn-outline-danger">Zablokovat</button>
            </form>
        }
    </div>
}

<h2 class="h4">Objednávky</h2>
@if (Model.Orders.Count == 0)
{
    <p class="text-muted">Žádné objednávky.</p>
}
else
{
    <div class="table-responsive admin-table"><table class="table table-sm">
        <thead>
            <tr>
                <th>Číslo</th>
                <th>Vytvořena</th>
                <th>Stav</th>
                <th class="num">Celkem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CreatedAtUtc.ToCzechString()</td>
                    <td><span class="badge @OrderStatusLabels.Badge(order.Status)">@OrderStatusLabels.Text(order.Status, order.ShippingMethod)</span></td>
                    <td class="num">@order.TotalPrice.ToString("N2") Kč</td>
                </tr>
            }
        </tbody>
    </table></div>
}

<h2 class="h4 mt-4">Poslední přihlášení</h2>
<partial name="_LoginAttempts" model="Model.LoginAttempts" />
<partial name="_Pager" model="Model.LoginAttemptPager" />

<h2 class="h4 mt-4">Historie změn</h2>
@if (Model.Audit.Count == 0)
{
    <p class="text-muted">Zatím žádné.</p>
}
else
{
    <div class="table-responsive admin-table"><table class="table table-sm">
        <tbody>
            @foreach (var entry in Model.Audit)
            {
                <tr>
                    <td class="text-nowrap">@entry.OccurredAtUtc.ToCzechString()</td>
                    <td>@IndexModel.ActionText(entry.Action)@(entry.Detail is null ? "" : $": {entry.Detail}")</td>
                    <td class="text-muted">provedl @entry.ActorEmail</td>
                </tr>
            }
        </tbody>
    </table></div>
}
