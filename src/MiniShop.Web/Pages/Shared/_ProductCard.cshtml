@using MiniShop.Web.Catalog
@model ProductCardModel
@{
    var p = Model.Product;
}
@* Redesign A: karta produktu – celá karta je odkaz na detail, tlačítko „Do košíku“ zůstává samostatně klikací. *@
<div class="card h-100 product-card">
    @* E-shop krok 2B: obrázek ze skladu přes Web (neměnné jméno → prohlížeč si ho drží v cache). *@
    @if (p.ImageFileName is not null)
    {
        <img src="@(ProductImageEndpoint.PathPrefix + p.ImageFileName)" alt="@p.Name" loading="lazy" class="card-img-top product-img" />
    }
    else
    {
        <div class="card-img-top product-img-placeholder">bez obrázku</div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <span class="text-muted small">@p.CategoryName</span>
            <span class="badge @AvailabilityLabels.Badge(p.Availability)">@AvailabilityLabels.Text(p.Availability)</span>
        </div>
        @* E-shop krok 14: detail produktu s hodnocením; hvězdičky z kopie katalogu (ProductRatingChangedV1). *@
        <h2 class="h6 card-title mb-1"><a asp-page="/Shop/Detail" asp-route-id="@p.ProductId" class="text-reset stretched-title" data-track="shop-product">@p.Name</a></h2>
        @if (p.RatingCount > 0)
        {
            <div class="small rating mb-1" title="@RatingStars.Summary(p.RatingAverage, p.RatingCount)">
                @RatingStars.For(p.RatingAverage) <span class="text-muted">(@p.RatingCount)</span>
            </div>
        }
        <p class="card-text text-muted small description flex-grow-1">@p.Description</p>
        <div class="product-card-footer mt-2">
            <span class="price">@p.Price.ToString("N2") Kč</span>
            @if (Model.CanOrder)
            {
                @if (p.Availability == "OutOfStock")
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>Vyprodáno</button>
                }
                else
                {
                    @* E-shop krok 3: do košíku (POST na stránku Košík, pak zpět i s filtry). Krok 4B: jediná cesta k objednávce. *@
                    <form method="post" asp-page="/Cart/Index" asp-page-handler="Add">
                        <input type="hidden" name="productId" value="@p.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-primary btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1" data-track="shop-add-to-cart">
                            @Icons.Cart <span>Do košíku</span>
                        </button>
                    </form>
                }
            }
            else if (Model.IsAnonymous)
            {
                <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-primary btn-sm w-100">Přihlásit a nakoupit</a>
            }
        </div>
    </div>
</div>
