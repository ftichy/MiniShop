# Cloud krok 2: vzor konfigurace pro docker compose. Zkopírujte do .env a změňte heslo:
#   cp .env.example .env
# Soubor .env je v .gitignore – tajné hodnoty nikdy do gitu.

# Účet do RabbitMQ (vytvoří se při PRVNÍM startu s prázdným volume; pozdější změna hesla tady
# už existující účet nezmění – viz docs/kroky-cloud/krok-02-compose.md).
# Heslo jen z písmen a číslic: je součástí adresy amqp://uzivatel:heslo@rabbitmq a znaky jako @ : / by ji rozbily.
RABBITMQ_USER=minishop
RABBITMQ_PASSWORD=ZmenteMe123

# Port, na kterém je Web vidět na tomto počítači (http://localhost:8080).
WEB_PORT=8080

# Štítek image (krok 7: tag z registry, např. sha-1a2b3c4). Lokálně "local".
IMAGE_TAG=local
