@using Microsoft.AspNetCore.Authorization
@using MiniShop.Web.Accounts
@inject IAuthorizationService AuthorizationService
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – MiniShop</title>
    @* Účty krok 8: Bootstrap 5.3.3 lokálně (ne z CDN) – CSP pouští jen vlastní soubory a cizí server nevidí návštěvníky. *@
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    @* asp-append-version: adresa nese otisk obsahu (?v=…) – po nasazení prohlížeč nepoužije starý soubor z cache. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            @* data-track = stabilní jméno prvku pro sledování a přehrávání průběhu objednávky (krok 12). *@
            <a class="navbar-brand" asp-page="/Index" data-track="nav-home">MiniShop</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-page="/Shop/Index" data-track="nav-shop">Obchod</a></li>
                @await Component.InvokeAsync("CartBadge")
                @* Účty krok 2: menu podle role – zamčené je to stejně na serveru, tady jde jen o to neukazovat slepé odkazy. *@
                @if ((await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.RequireAdmin)).Succeeded)
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Products/Index" data-track="nav-products">Produkty</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Fulfilment/Index" data-track="nav-fulfilment">Expedice</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Returns/Index" data-track="nav-returns">Vratky</a></li>   @* e-shop krok 12 *@
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Users/Index" data-track="nav-users">Uživatelé</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Sales/Index" data-track="nav-sales">Přehled</a></li>   @* e-shop krok 11 *@
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Coupons/Index" data-track="nav-coupons">Kupony</a></li>   @* e-shop krok 13 *@
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Reviews/Index" data-track="nav-reviews">Hodnocení</a></li>   @* e-shop krok 14 *@
                }
                <li class="nav-item"><a class="nav-link" asp-page="/Orders/Index" data-track="nav-orders">Objednávky</a></li>
                <li class="nav-item"><a class="nav-link" href="/Docs" data-track="nav-docs">Dokumentace</a></li>
            </ul>
            <partial name="_LoginPartial" />
        </div>
    </nav>
    <main class="container">
        <partial name="_EmailConfirmationBanner" />
        @RenderBody()
    </main>
    @* Účty krok 9: veřejný web – informace o osobních údajích musí být dostupná odkudkoli. *@
    <footer class="container border-top mt-5 py-3 text-muted small">
        MiniShop – výukový e-shop · <a asp-page="/Privacy" data-track="nav-privacy">Ochrana osobních údajů</a>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
