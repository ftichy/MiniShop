# Cloud krok 10: NETAJNÁ konfigurace produkce (VM v cloudu). Změna = PR → po sloučení ji nasadí CD.
# Z tohoto souboru, štítku image a secrets z GitHubu (environment production) sestaví deploy.sh na VM soubor .env.
# Nic tajného sem nepatří – repozitář je veřejný. Tajné hodnoty: RABBITMQ_PASSWORD, BASIC_AUTH_HASH, SMTP_PASSWORD,
# INVENTORY_API_KEY, PAYMENTS_WEBHOOK_SECRET, POSTGRES_PASSWORD, GOOGLE_CLIENT_SECRET, GRAFANA_CLOUD_OTLP_TOKEN,
# PUSH_VAPID_PRIVATE_KEY (viz docs/secrets.md).

# Compose na VM čte i doplněk s Caddy (HTTPS + zámek), viz compose.cloud.yaml, a od observability G1 doplněk
# s Alloyem (telemetrie i do Grafana Cloud), viz compose.grafana.yaml – vypnutí = odebrat ho odsud.
COMPOSE_FILE=compose.yaml:compose.cloud.yaml:compose.grafana.yaml

# Image z registry (krok 7). IMAGE_TAG=sha-… doplní deploy.sh podle nasazovaného commitu.
IMAGE_PREFIX=ghcr.io/ftichy/

# Doména pro certifikát Let's Encrypt (krok 5). Krok 13: vlastní doména (Wedos, DNS záznamy A pro @ a dashboard).
DOMAIN=minishop-tichy.cz
# Krok 13: původní adresa – Caddy z ní trvale přesměruje na DOMAIN (záložky, starší odkazy z e-mailů).
LEGACY_DOMAIN=minishop-tichy.duckdns.org

# Zámek před aplikací (krok 5). Účty krok 9: off – web je veřejný, chrání ho vlastní přihlašování a role.
# Aspire dashboard má zámek vždy (Caddyfile), proto BASIC_AUTH_USER a secret BASIC_AUTH_HASH zůstávají.
BASIC_AUTH=off
BASIC_AUTH_USER=minishop

# Škálování krok 5: Web ve dvou kopiích za Caddy (workery s časovačem jen na vedoucí – zámek v PostgreSQL).
# Výpadek jedné kopie web nezastaví. Sklad (inventory-api) zatím v jedné kopii.
WEB_REPLICAS=2

# Účet do RabbitMQ (heslo je secret). Jméno se po prvním startu už nemění – vznikl s ním volume.
RABBITMQ_USER=minishop

# Účty krok 5: e-maily přes Gmail (heslo aplikace je secret SMTP_PASSWORD). Odesílatel = účet, jinak ho Gmail přepíše.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=ftichy.gemini@gmail.com
EMAIL_FROM_ADDRESS=ftichy.gemini@gmail.com

# E-shop krok 7: veřejná adresa webu pro odkazy v e-mailech o objednávce (modul Notifications).
PUBLIC_BASE_URL=https://minishop-tichy.cz

# Účty krok 10: přihlášení přes Google – Client ID OAuth klienta (Google Cloud Console, projekt MiniShop). Není tajné
# (prohlížeč ho vidí v adrese přesměrování), tajemství je secret GOOGLE_CLIENT_SECRET. Prázdné = tlačítko se neukáže.
GOOGLE_CLIENT_ID=825678804918-biqqcpfeoe404grts1b3adf2c7tg5qbn.apps.googleusercontent.com

# E-shop krok 23: oznámení push – veřejný klíč VAPID (příkaz generate-vapid-keys). Není tajný (dostává ho prohlížeč),
# soukromý klíč je secret PUSH_VAPID_PRIVATE_KEY. Prázdné = oznámení push vypnutá (sekce na stránce nastavení se neukáže).
PUSH_VAPID_PUBLIC_KEY=BNFMfqcvWrNAVtDqQPnQsvLRyILr-XSO0Spcu8ihisF5h27J0XQaPudw2gtWSvmsVDT1jWuL69G07laPolWEsbk

# E-shop krok 16: platební brána – Fake (simulace) nebo Stripe (testovací režim). Stripe potřebuje secrets
# STRIPE_SECRET_KEY a STRIPE_WEBHOOK_SECRET v environmentu production – bez nich by se Web nespustil.
PAYMENTS_GATEWAY=Stripe

# Observabilita G1: Grafana Cloud (stack patientjaguar2071, region EU Germany). Adresa a číslo instance nejsou tajné,
# tajný je token jen se zápisem (secret GRAFANA_CLOUD_OTLP_TOKEN). Používá je Alloy (config.alloy).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-4.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=1921678

# E-shop krok 26C: simulovaný dopravce posílá webhooky o stavu zásilky Webu uvnitř sítě Compose (jméno "web" = všechny
# kopie). Krok 30 s = doručení za ~2 min. Mírné „zlobení“ (0–1), aby bylo vidět, že si s ním e-shop poradí:
# webhook dvakrát / mimo pořadí / vůbec (dožene dohledání), 503 a ztracená odpověď při předání (opakování, Idempotency-Key).
CARRIER_WEBHOOK_URL=http://web:8080/api/shipping/carrier-webhook
CARRIER_STEP_SECONDS=30
CARRIER_CHAOS_DUPLICATE_RATE=0.2
CARRIER_CHAOS_REORDER_RATE=0.2
CARRIER_CHAOS_DROP_RATE=0.1
CARRIER_CHAOS_FAILURE_RATE=0.05
CARRIER_CHAOS_LOST_RESPONSE_RATE=0.05
CARRIER_CHAOS_REJECT_RATE=0
