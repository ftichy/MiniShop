# Ukázkové požadavky na API. Ve Visual Studiu / VS Code klikněte na "Send Request" nad požadavkem.
@host = https://localhost:7180
# Krok 10B: produkty patří službě skladu (MiniShop.Inventory.Api).
@inventory = https://localhost:7181

### Seznam produktů
GET {{inventory}}/api/products

### Detail produktu
GET {{inventory}}/api/products/1

### Nový produkt
POST {{inventory}}/api/products
Content-Type: application/json

{
  "name": "Webkamera",
  "description": "Full HD 1080p",
  "price": 1290.00,
  "stockQuantity": 20
}

### Úprava produktu
PUT {{inventory}}/api/products/1
Content-Type: application/json

{
  "name": "Mechanická klávesnice",
  "description": "Hnědé spínače, CZ layout, podsvícení",
  "price": 2390.00
}

### Naskladnění
POST {{inventory}}/api/products/1/stock
Content-Type: application/json

{
  "quantity": 10
}

### Smazání produktu
DELETE {{inventory}}/api/products/6

# Účty krok 2: API objednávek chce přihlášení (bez něj 401). Přihlaste se v prohlížeči na {{host}}/Account/Login,
# zkopírujte cookie .MiniShop.Auth (F12 → Application → Cookies) a vložte ji sem. Objednávky zakládá jen zákazník
# (role User), vyřizuje jen admin.
@auth = .MiniShop.Auth=SEM-VLOZTE-HODNOTU-COOKIE

### Seznam objednávek
GET {{host}}/api/orders
Cookie: {{auth}}

### Nová objednávka (10 ks kabelů => množstevní sleva 10 %)
POST {{host}}/api/orders
Content-Type: application/json
Cookie: {{auth}}

{
  "customerName": "Jan Novák",
  "customerEmail": "jan.novak@example.com",
  "items": [
    { "productId": 1, "quantity": 1 },
    { "productId": 4, "quantity": 10 }
  ]
}

### Objednávka s nedostatkem zboží => 400 Bad Request
POST {{host}}/api/orders
Content-Type: application/json
Cookie: {{auth}}

{
  "customerName": "Petra Malá",
  "customerEmail": "petra@example.com",
  "items": [ { "productId": 3, "quantity": 999 } ]
}

### Vyřízení objednávky (jen admin)
POST {{host}}/api/orders/1/complete
Cookie: {{auth}}

### Zrušení objednávky (vrátí zboží na sklad)
POST {{host}}/api/orders/1/cancel
Cookie: {{auth}}
