{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (metriky)",
      "description": "Zdroj metrik Grafana Cloud – končí na -prom",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "MiniShop – zprávy a ságy",
  "uid": "minishop-zpravy-a-sagy",
  "description": "Observabilita G2: je EDA část MiniShopu v pořádku? Zdroj: deploy/grafana/minishop-zpravy-a-sagy.json v repozitáři (změna = PR + nový import).",
  "tags": ["minishop", "eda"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "Je vše v pořádku? (zelená = ano)", "collapsed": false, "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "type": "stat", "title": "Poison zprávy v outboxu", "id": 1,
      "description": "Zprávy, které vyčerpaly pokusy o doručení a čekají na člověka (/Admin/Messages → Zkusit znovu). Má být 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(max by (module) (minishop_outbox_poison)) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Zprávy v dead-letter frontách", "id": 2,
      "description": "Zprávy, které consumer 5× nezpracoval (minishop.{modul}.dead). Má být 0 – detail a vrácení na /Admin/Messages.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(max by (queue) (minishop_queue_dead_letters)) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Čekající v outboxu", "id": 3,
      "description": "Nezpracované zprávy ve všech outboxech. Krátce nenulové je normální (worker jede každé 2 s); trvale vysoké = doručování vázne.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(max by (module) (minishop_outbox_pending)) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Čeká ve frontách RabbitMQ", "id": 4,
      "description": "Zprávy ve frontách modulů, které consumer ještě nepřevzal. Trvale vysoké = consumer nestíhá nebo neběží.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(max by (queue) (minishop_queue_backlog)) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Potvrzení objednávky p95 (bez karty, 24 h)", "id": 5,
      "description": "Za kolik sekund sága potvrdí 95 % objednávek (dobírka a API – u karty se počítá i zadávání karty zákazníkem). Cíl (G3): do 30 s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (increase(minishop_order_confirmation_duration_seconds_bucket{payment!=\"card\"}[24h])))", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "noValue": "žádná objednávka", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 15 }, { "color": "red", "value": 30 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Chyby 5xx (posledních 15 min)", "id": 6,
      "description": "Odpovědi se stavem 5xx z Webu i skladu. Má být 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [ { "refId": "A", "expr": "round(sum(increase(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[15m]))) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row", "title": "Zprávy (outbox → RabbitMQ → consumer)", "collapsed": false, "id": 101,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Doručené z outboxu za minutu (podle modulu)", "id": 7,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [ { "refId": "A", "expr": "sum by (module) (rate(minishop_outbox_delivered_total[5m])) * 60", "legendFormat": "{{module}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Zpracované consumerem za minutu (podle fronty)", "id": 8,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [ { "refId": "A", "expr": "sum by (queue) (rate(minishop_consumer_handled_total[5m])) * 60", "legendFormat": "{{queue}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Chyby doručení a zpracování za minutu", "id": 9,
      "description": "Selhané pokusy – jednotlivé se samy zopakují (backoff). Trvalé chyby skončí jako poison / dead-letter.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "sum by (module) (rate(minishop_outbox_failed_total[5m])) * 60", "legendFormat": "outbox {{module}}" },
        { "refId": "B", "expr": "sum by (queue) (rate(minishop_consumer_failed_total[5m])) * 60", "legendFormat": "consumer {{queue}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Zpoždění outboxu (od vzniku po odeslání)", "id": 10,
      "description": "Jak dlouho zpráva čekala v outboxu. Běžně do 2 s (kolo workeru); delší = backoff po chybách nebo zahlcení.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(minishop_outbox_delay_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(minishop_outbox_delay_seconds_bucket[5m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Fronty a outboxy – co čeká", "id": 11,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "max by (queue) (minishop_queue_backlog) > 0", "legendFormat": "fronta {{queue}}" },
        { "refId": "B", "expr": "max by (queue) (minishop_queue_dead_letters) > 0", "legendFormat": "dead-letter {{queue}}" },
        { "refId": "C", "expr": "max by (module) (minishop_outbox_pending) > 0", "legendFormat": "outbox {{module}}" },
        { "refId": "D", "expr": "max by (module) (minishop_outbox_poison) > 0", "legendFormat": "poison {{module}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "noValue": "nic nečeká", "custom": { "fillOpacity": 10, "drawStyle": "line" } }, "overrides": [] }
    },
    {
      "type": "row", "title": "Ságy a objednávky", "collapsed": false, "id": 102,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Rozpracované ságy podle stavu", "id": 12,
      "description": "Reserved/Shipped trvají až do expedice a doručení (normální). AwaitingReservation / ReleasingStock déle než pár sekund = sága čeká na odpověď skladu.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [ { "refId": "A", "expr": "max by (saga, state) (minishop_saga_active)", "legendFormat": "{{saga}} {{state}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 0, "lineInterpolation": "stepAfter" } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Doba potvrzení objednávky (p50 / p95, 1 h)", "id": 13,
      "description": "Od založení objednávky po potvrzení ságou, podle způsobu platby (none = API, cashondelivery = dobírka, card = včetně zadávání karty).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, payment) (rate(minishop_order_confirmation_duration_seconds_bucket[1h])))", "legendFormat": "p50 {{payment}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, payment) (rate(minishop_order_confirmation_duration_seconds_bucket[1h])))", "legendFormat": "p95 {{payment}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "showPoints": "always" } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Potvrzené objednávky za hodinu", "id": 14,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [ { "refId": "A", "expr": "sum by (payment) (increase(minishop_order_confirmation_duration_seconds_count[1h]))", "legendFormat": "{{payment}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },
    {
      "type": "row", "title": "HTTP (Web a sklad)", "collapsed": false, "id": 103,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Požadavky za minutu", "id": 15,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[5m])) * 60", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Doba odpovědi p95", "id": 16,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Chyby 5xx za minutu (podle stránky)", "id": 17,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "targets": [ { "refId": "A", "expr": "sum by (job, http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) * 60", "legendFormat": "{{job}} {{http_route}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "noValue": "žádné chyby", "custom": { "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
