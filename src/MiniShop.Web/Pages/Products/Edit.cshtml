@page "{id:int}"
@model MiniShop.Web.Pages.Products.EditModel
@{
    ViewData["Title"] = "Úprava produktu";
}
<h1>Úprava produktu</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" style="max-width: 40rem">
    <div class="mb-3">
        <label asp-for="Product.Name" class="form-label"></label>
        <input asp-for="Product.Name" class="form-control" />
        <span asp-validation-for="Product.Name" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Product.CategoryId" class="form-label"></label>
        <select asp-for="Product.CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="0">-- vyberte --</option>
        </select>
        <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Product.Description" class="form-label"></label>
        <textarea asp-for="Product.Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Product.Description" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Product.Price" class="form-label"></label>
        <input asp-for="Product.Price" class="form-control" style="max-width: 12rem" />
        <span asp-validation-for="Product.Price" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Uložit</button>
    <a asp-page="/Products/Index" class="btn btn-link">Zpět na produkty</a>
</form>
