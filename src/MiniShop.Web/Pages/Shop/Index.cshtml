@page
@using MiniShop.Application.Ordering.Catalog
@using MiniShop.Web.Catalog
@model MiniShop.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Obchod";
}
<div class="d-flex justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="mb-1">Obchod</h1>
        <p class="text-muted small mb-0">
            @Model.Result.TotalCount @(Model.Result.TotalCount switch { 1 => "produkt", >= 2 and <= 4 => "produkty", _ => "produktů" })
            @if (Model.HasFilter)
            {
                <text>· <a asp-page="/Shop/Index">zrušit filtry</a></text>
            }
        </p>
    </div>
    @* Redesign A: na mobilu jsou filtry ve vysouvacím panelu (offcanvas-lg = na velké obrazovce normálně vedle výsledků). *@
    <button class="btn btn-outline-primary d-lg-none d-inline-flex align-items-center gap-2" type="button"
            data-bs-toggle="offcanvas" data-bs-target="#shop-filters" aria-controls="shop-filters" data-track="shop-filters-open">
        @Icons.Filter Filtry
    </button>
</div>

@* E-shop krok 3: hláška po přidání do košíku (nastavuje stránka Košík, sem se vrací přes returnUrl). *@
@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage <a asp-page="/Cart/Index" class="alert-link">Zobrazit košík</a></div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <aside class="col-lg-3">
        <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="shop-filters" aria-labelledby="shop-filters-title">
            <div class="offcanvas-header">
                <h2 class="offcanvas-title h5" id="shop-filters-title">Filtry</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#shop-filters" aria-label="Zavřít"></button>
            </div>
            <div class="offcanvas-body">
                @* E-shop krok 2: formulář GET – filtry jsou v adrese (/Shop?q=mys&category=2), výsledek jde sdílet odkazem. *@
                <form method="get" class="card card-body w-100 d-flex flex-column gap-3" role="search">
                    <div>
                        <label for="q" class="form-label fw-semibold">Hledat</label>
                        <input id="q" name="q" value="@Model.Query" type="search" maxlength="100" placeholder="např. myš, kabel…"
                               class="form-control" data-track="shop-search" />
                    </div>
                    <div>
                        <label for="category" class="form-label fw-semibold">Kategorie</label>
                        <select id="category" name="category" class="form-select" data-track="shop-category">
                            <option value="">Všechny kategorie</option>
                            @foreach (var c in Model.Result.Categories)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name (@c.ProductCount)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="sort" class="form-label fw-semibold">Řadit</label>
                        <select id="sort" name="sort" class="form-select" data-track="shop-sort">
                            <option value="@CatalogSort.Name" selected="@(Model.Sort == CatalogSort.Name)">podle názvu</option>
                            <option value="@CatalogSort.PriceAscending" selected="@(Model.Sort == CatalogSort.PriceAscending)">od nejlevnějšího</option>
                            <option value="@CatalogSort.PriceDescending" selected="@(Model.Sort == CatalogSort.PriceDescending)">od nejdražšího</option>
                            <option value="@CatalogSort.BestRated" selected="@(Model.Sort == CatalogSort.BestRated)">nejlépe hodnocené</option>
                        </select>
                    </div>
                    <div class="form-check form-switch">
                        <input id="instock" name="instock" value="true" type="checkbox" role="switch" class="form-check-input" checked="@Model.InStockOnly" />
                        <label for="instock" class="form-check-label">Jen skladem</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" data-track="shop-submit">Zobrazit výsledky</button>
                </form>
            </div>
        </div>
    </aside>

    <section class="col-lg-9">
        @* Redesign A: rychlý výběr kategorie štítky (vodorovně posuvné na mobilu). *@
        @if (Model.Result.Categories.Count > 1)
        {
            <nav class="chip-row mb-3" aria-label="Kategorie">
                <a class="category-chip @(Model.CategoryId is null ? "active" : "")" asp-page="/Shop/Index"
                   asp-all-route-data="Model.RouteForCategory(null)">Vše</a>
                @foreach (var c in Model.Result.Categories)
                {
                    <a class="category-chip @(c.Id == Model.CategoryId ? "active" : "")" asp-page="/Shop/Index"
                       asp-all-route-data="Model.RouteForCategory(c.Id)" data-track="shop-category-chip">
                        @c.Name <span class="count">@c.ProductCount</span>
                    </a>
                }
            </nav>
        }

        @if (Model.Result.Items.Count == 0)
        {
            <div class="alert alert-info">
                @(Model.HasFilter ? "Nic jsme nenašli. Zkuste jiné slovo nebo zrušte filtry." : "Nabídka se načítá ze skladu… Zkuste to za chvíli.")
            </div>
        }

        @* Redesign A: na telefonu dvě karty vedle sebe, na tabletu a počítači tři. *@
        <div class="row row-cols-2 row-cols-md-3 g-3">
            @foreach (var p in Model.Result.Items)
            {
                <div class="col"><partial name="_ProductCard" model="Model.Card(p)" /></div>
            }
        </div>

        @if (Model.Result.PageCount > 1)
        {
            <nav aria-label="Stránky výsledků" class="mt-4">
                <ul class="pagination flex-wrap">
                    @for (var i = 1; i <= Model.Result.PageCount; i++)
                    {
                        <li class="page-item @(i == Model.Result.Page ? "active" : "")">
                            <a class="page-link" asp-page="/Shop/Index" asp-all-route-data="Model.RouteFor(i)">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <p class="text-muted small mt-4">
            Dostupnost se může o pár sekund opozdit – o objednávce rozhoduje až rezervace na skladě.
        </p>
    </section>
</div>
