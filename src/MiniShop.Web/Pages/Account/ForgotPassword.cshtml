@page
@model MiniShop.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Zapomenuté heslo";
}
<h1>Zapomenuté heslo</h1>

@if (Model.Sent)
{
    <div class="alert alert-success">
        Pokud účet s tímto e-mailem existuje, poslali jsme na něj odkaz pro nastavení nového hesla.
        Odkaz platí 2 hodiny. Zkontrolujte i složku se spamem.
    </div>
    <p><a asp-page="/Account/Login">Zpět na přihlášení</a></p>
}
else
{
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <p>Zadejte e-mail účtu, pošleme vám odkaz pro nastavení nového hesla.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary">Poslat odkaz</button>
            </form>
        </div>
    </div>
}
