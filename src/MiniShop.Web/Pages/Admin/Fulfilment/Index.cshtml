@page
@model MiniShop.Web.Pages.Admin.Fulfilment.IndexModel
@{
    ViewData["Title"] = "Expedice";
}
<partial name="_AdminHeader" model='new MiniShop.Web.Ui.AdminHeaderModel("Expedice")' />
<p class="text-muted">
    Objednávka jde postupně: <strong>potvrzená → balíme → předat dopravci → odeslaná → doručená</strong>. Zrušit ji zákazník může,
    dokud se nepředává dopravci. Číslo zásilky přidělí dopravce (pár sekund), pak sklad vydá zboží a zákazník dostane e-mail.
</p>

<partial name="_StatusMessage" model="Model.StatusMessage" />
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* Fronta 1: potvrzené objednávky – hromadně začít balit (zaškrtnout a jedno tlačítko). *@
<h2 class="h4 mt-4">K zabalení <span class="badge badge-soft-primary">@Model.ToPack.Count</span></h2>
@if (Model.ToPack.Count == 0)
{
    <p class="text-muted">Nic nečeká.</p>
}
else
{
    <form method="post" asp-page-handler="StartPacking">
        <div class="table-responsive admin-table"><table class="table table-sm align-middle">
            <thead>
                <tr><th></th><th>Objednávka</th><th>Zákazník</th><th>Doprava</th><th>Položky</th><th class="num">Celkem</th></tr>
            </thead>
            <tbody>
                @foreach (var order in Model.ToPack)
                {
                    <tr>
                        <td><input type="checkbox" name="ids" value="@order.Id" class="form-check-input" disabled="@Model.IsOwn(order)" aria-label="Vybrat objednávku @order.Id" /></td>
                        <td><a asp-page="/Orders/Detail" asp-route-id="@order.Id">č. @order.Id</a><partial name="_OwnOrderBadge" model="Model.IsOwn(order)" /></td>
                        <td>@order.CustomerName</td>
                        <td>@ShippingText(order)</td>
                        <td class="small">@string.Join(", ", order.Items.Select(i => $"{i.Quantity}× {i.ProductName}"))</td>
                        <td class="num">@order.TotalPrice.ToString("N2") Kč</td>
                    </tr>
                }
            </tbody>
        </table></div>
        <button type="submit" class="btn btn-primary btn-sm" data-track="fulfilment-start-packing">Začít balit vybrané</button>
    </form>
}

@* Fronta 2: balí se – odeslat (kurýr: dopravce + číslo zásilky; osobní odběr: jen „připraveno k vyzvednutí“). *@
<h2 class="h4 mt-5">K odeslání <span class="badge badge-soft-info">@Model.ToShip.Count</span></h2>
@if (Model.ToShip.Count == 0)
{
    <p class="text-muted">Nic se nebalí.</p>
}
<datalist id="carriers">
    @foreach (var carrier in IndexModel.Carriers)
    {
        <option value="@carrier"></option>
    }
</datalist>
<div class="list-group">
    @foreach (var order in Model.ToShip)
    {
        <div class="list-group-item">
            <form method="post" asp-page-handler="Ship" asp-route-id="@order.Id" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <a asp-page="/Orders/Detail" asp-route-id="@order.Id" class="fw-bold">č. @order.Id</a> – @order.CustomerName <partial name="_OwnOrderBadge" model="Model.IsOwn(order)" />
                    <div class="small text-muted">@ShippingText(order)</div>
                </div>
                @if (order.ShippingMethod == "Pickup")
                {
                    <div class="col-md-8 text-md-end">
                        <button type="submit" class="btn btn-success btn-sm" data-track="fulfilment-ship" disabled="@Model.IsOwn(order)">Připraveno k vyzvednutí</button>
                    </div>
                }
                else if (order.ShippingMethod == "Courier")
                {
                    @* E-shop krok 26B: kurýr = předat dopravci; číslo zásilky přidělí on (zprávou za pár sekund). *@
                    <div class="col-md-8 text-md-end">
                        @if (order.AwaitingShipment)
                        {
                            <span class="badge badge-soft-info" data-track="fulfilment-handing-over" data-reload-when-idle>Předává se dopravci…</span>
                        }
                        else
                        {
                            <button type="submit" formaction="?handler=HandOver&amp;id=@order.Id" class="btn btn-success btn-sm"
                                    data-track="fulfilment-hand-over" disabled="@Model.IsOwn(order)">
                                @(order.ShipmentError is null ? "Předat dopravci" : "Zkusit znovu")
                            </button>
                        }
                    </div>
                    @if (order.ShipmentError is not null && !order.AwaitingShipment)
                    {
                        <div class="col-12">
                            <div class="alert alert-warning small mb-0 py-2" data-track="fulfilment-shipment-error">@order.ShipmentError</div>
                        </div>
                    }
                    @if (!order.AwaitingShipment)
                    {
                        @* Záloha pro delší výpadek dopravce: odeslat jiným dopravcem a opsat číslo ručně (jako před krokem 26B). *@
                        <div class="col-12">
                            <details class="small" data-track="fulfilment-manual">
                                <summary>Odeslat jiným dopravcem (ručně)</summary>
                                <div class="row g-2 align-items-end mt-1">
                                    <div class="col-md-4">
                                        <label for="carrier-@order.Id" class="form-label small mb-0">Dopravce</label>
                                        <input id="carrier-@order.Id" name="carrier" list="carriers" maxlength="50" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4">
                                        <label for="tracking-@order.Id" class="form-label small mb-0">Číslo zásilky</label>
                                        <input id="tracking-@order.Id" name="trackingNumber" maxlength="50" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4 text-md-end">
                                        <button type="submit" class="btn btn-outline-success btn-sm" data-track="fulfilment-ship" disabled="@Model.IsOwn(order)">Odeslat ručně</button>
                                    </div>
                                </div>
                            </details>
                        </div>
                    }
                }
                else
                {
                    @* Objednávky bez dopravy (API): dopravce a číslo zásilky ručně, nepovinné. *@
                    <div class="col-md-3">
                        <label for="carrier-@order.Id" class="form-label small mb-0">Dopravce</label>
                        <input id="carrier-@order.Id" name="carrier" list="carriers" maxlength="50" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label for="tracking-@order.Id" class="form-label small mb-0">Číslo zásilky</label>
                        <input id="tracking-@order.Id" name="trackingNumber" maxlength="50" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2 text-md-end">
                        <button type="submit" class="btn btn-success btn-sm" data-track="fulfilment-ship" disabled="@Model.IsOwn(order)">Odeslat</button>
                    </div>
                }
            </form>
        </div>
    }
</div>

@* Fronta 3: na cestě – u zásilek předaných dopravci hlásí doručení dopravce (e-shop krok 26C), jinak ručně „Doručeno“. *@
<h2 class="h4 mt-5">Na cestě <span class="badge badge-soft-primary">@Model.InTransit.Count</span></h2>
@if (Model.InTransit.Count == 0)
{
    <p class="text-muted">Nic není na cestě.</p>
}
else
{
    @* Vzhled C: seznam místo tabulky – tlačítko Doručeno je na telefonu pod palcem bez posouvání do strany. *@
    <div class="list-group">
        @foreach (var order in Model.InTransit)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <a asp-page="/Orders/Detail" asp-route-id="@order.Id" class="fw-bold">č. @order.Id</a> – @order.CustomerName <partial name="_OwnOrderBadge" model="Model.IsOwn(order)" />
                    <div class="small text-muted">@(order.ShippingMethod == "Pickup" ? "čeká na vyzvednutí" : $"{order.Carrier} {order.TrackingNumber}".Trim())</div>
                </div>
                @if (Model.CanMarkDelivered(order))
                {
                    <form method="post" asp-page-handler="Deliver" asp-route-id="@order.Id">
                        <button type="submit" class="btn btn-outline-success btn-sm" data-track="fulfilment-deliver" disabled="@Model.IsOwn(order)">
                            @(order.ShippingMethod == "Pickup" ? "Vyzvednuto" : "Doručeno")
                        </button>
                    </form>
                }
                else
                {
                    @* E-shop krok 26C: doručení hlásí dopravce (webhook / dohledání) – stav a čas poslední novinky. *@
                    var tracking = Model.Tracking.GetValueOrDefault(order.Id);
                    <span class="badge badge-soft-info" data-track="fulfilment-carrier-status" data-reload-when-idle>
                        @MiniShop.Web.Shipping.ShipmentStatusLabels.Label(tracking?.Status ?? "Created")@(tracking?.LastUpdateAtUtc is { } at ? $" · {at.ToCzechString()}" : "")
                    </span>
                }
            </div>
        }
    </div>
}

@functions {
    private static string ShippingText(OrderDto order) => order.ShippingMethod switch
    {
        "Courier" => $"kurýr – {order.DeliveryAddress}",
        "Pickup" => "osobní odběr",
        _ => "bez dopravy (API)"
    };
}

@section Scripts {
    @* E-shop krok 26B: „Předává se dopravci…“ – stránka se sama obnoví, až přijde číslo zásilky. *@
    <script src="~/js/orders-reload.js" asp-append-version="true"></script>
}
