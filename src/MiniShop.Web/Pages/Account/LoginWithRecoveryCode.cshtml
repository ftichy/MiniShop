@page
@model MiniShop.Web.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Záchranný kód";
}
<h1>Záchranný kód</h1>
<p class="text-muted">Opište jeden ze záchranných kódů, které jste dostali při zapnutí dvoufázového ověření. Použitý kód přestane platit.</p>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" autofocus />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Přihlásit</button>
        </form>
        <p class="mt-3"><a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">Zpět na kód z aplikace</a></p>
    </div>
</div>
