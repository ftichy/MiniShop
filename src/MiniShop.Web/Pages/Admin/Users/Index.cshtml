@page
@model MiniShop.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Uživatelé";
}
<partial name="_AdminHeader" model='new MiniShop.Web.Ui.AdminHeaderModel("Uživatelé")' />
<p class="text-muted">
    Nový admin se nejdřív zaregistruje sám (heslo zná jen on), pak ho tady povýšíte.
    Útrata = potvrzené a vyřízené objednávky.
</p>

@* Stránkování: hledání podle části e-mailu (GET – zachová velikost stránky). *@
<form method="get" class="row g-2 align-items-end mb-2" role="search" data-track="users-search">
    <div class="col-12 col-sm-auto">
        <label for="users-search" class="form-label small mb-0">E-mail obsahuje</label>
        <input id="users-search" name="q" type="search" value="@Model.Search" class="form-control form-control-sm" />
    </div>
    @if (Model.PageSize is { } size)
    {
        <input type="hidden" name="size" value="@size" />
    }
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Hledat</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="/Admin/Users/Index" class="btn btn-sm btn-link">Zrušit hledání</a>
        }
    </div>
</form>

@if (Model.Users.Count == 0 && !string.IsNullOrWhiteSpace(Model.Search))
{
    <p class="text-muted">Žádný účet s e-mailem obsahujícím „@Model.Search“.</p>
}

@* Telefon: každý uživatel jako karta pod sebou (bez posouvání do strany); od md výš tabulka. *@
<div class="d-md-none mb-3" data-track="users-cards">
    @foreach (var row in Model.Users)
    {
        var account = row.Account;
        <div class="card mb-2">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <a asp-page="/Admin/Users/Detail" asp-route-id="@account.Id" class="fw-semibold text-break">@account.DisplayName</a>
                    <partial name="_LockBadge" model="account" />
                </div>
                <div class="text-break small">
                    @account.Email
                    @if (!account.EmailConfirmed)
                    {
                        <span class="badge badge-soft-secondary ms-1" title="E-mail není potvrzený">nepotvrzený</span>
                    }
                </div>
                <div class="my-1"><partial name="_RoleBadge" model="account.Roles" /></div>
                <div class="small text-muted">Objednávky: @row.OrderCount · Útrata: @row.TotalSpent.ToString("N2") Kč</div>
            </div>
        </div>
    }
</div>

<div class="table-responsive admin-table d-none d-md-block"><table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>E-mail</th>
            <th>Role</th>
            <th>Stav</th>
            <th class="num">Objednávky</th>
            <th class="num">Útrata</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Users)
        {
            var account = row.Account;
            <tr>
                <td><a asp-page="/Admin/Users/Detail" asp-route-id="@account.Id">@account.DisplayName</a></td>
                <td>
                    @account.Email
                    @if (!account.EmailConfirmed)
                    {
                        <span class="badge badge-soft-secondary ms-1" title="E-mail není potvrzený">nepotvrzený</span>
                    }
                </td>
                <td><partial name="_RoleBadge" model="account.Roles" /></td>
                <td><partial name="_LockBadge" model="account" /></td>
                <td class="num">@row.OrderCount</td>
                <td class="num">@row.TotalSpent.ToString("N2") Kč</td>
            </tr>
        }
    </tbody>
</table></div>

<partial name="_Pager" model="Model.Pager" />

<h2 class="h4 mt-4">Poslední změny</h2>
@if (Model.RecentAudit.Count == 0)
{
    <p class="text-muted">Zatím žádné.</p>
}
else
{
    <div class="table-responsive admin-table"><table class="table table-sm">
        <tbody>
            @foreach (var entry in Model.RecentAudit)
            {
                <tr>
                    <td class="text-nowrap">@entry.OccurredAtUtc.ToCzechString()</td>
                    <td>
                        <a asp-page="/Admin/Users/Detail" asp-route-id="@entry.TargetUserId">@entry.TargetEmail</a>
                        @IndexModel.ActionText(entry.Action)@(entry.Detail is null ? "" : $": {entry.Detail}")
                    </td>
                    <td class="text-muted">provedl @entry.ActorEmail</td>
                </tr>
            }
        </tbody>
    </table></div>
}
