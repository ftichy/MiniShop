{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Carrier": {
    "StepSeconds": 30,
    "Chaos": {
      "FailureRate": 0,
      "LostResponseRate": 0,
      "DuplicateRate": 0,
      "ReorderRate": 0,
      "DropRate": 0,
      "UndeliverableRate": 0
    }
  }
}
