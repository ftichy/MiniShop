{
  "ConnectionStrings": {
    "Ordering": "Data Source=ordering.db",
    "Journeys": "Data Source=journeys.db",
    "Notifications": "Data Source=notifications.db",
    "Payments": "Data Source=payments.db",
    "Reporting": "Data Source=reporting.db",
    "Reviews": "Data Source=reviews.db",
    "Accounts": "Data Source=users.db"
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "Retention": {
      "OutboxDays": 7,
      "InboxDays": 30
    },
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "ClientName": "MiniShop.Web",
      "AuditQueue": "minishop.audit"
    }
  },
  "Sagas": {
    "ReservationTimeoutSeconds": 30
  },
  "Returns": {
    "WindowDays": 14,
    "SendWindowDays": 14
  },
  "Carts": {
    "AbandonedAfterHours": 24,
    "ReminderCheckMinutes": 15
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "FromAddress": "minishop@localhost",
    "FromName": "MiniShop"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/minishop-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
