<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastruktura: implementace rozhraní z aplikační vrstvy (EF Core + SQLite, notifikace, RabbitMQ). -->
  <ItemGroup>
    <ProjectReference Include="..\MiniShop.Application\MiniShop.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Účty krok 5: odesílání e-mailů přes SMTP (Gmail v produkci, Mailpit lokálně). -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- Tranzitivní závislost MailKitu (MimeKit, S/MIME) připnutá na opravenou verzi – 10.0.0 má zranitelnosti
         GHSA-846f-f764-76mx a GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Účty krok 1: ASP.NET Core Identity – uživatelé a role v users.db (modul Accounts). -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Účty krok 6: nástroj dotnet ef (migrace users.db) – jen při vývoji, do aplikace se nedostane. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Krok 10B: workery (BackgroundService) a AddMessaging sdílí obě služby (Web i Inventory.Api). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <!-- Krok 11: health check outboxu (OutboxHealthCheck). Trasy a metriky stačí z .NET (System.Diagnostics). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
</Project>
