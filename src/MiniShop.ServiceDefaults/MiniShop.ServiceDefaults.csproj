<Project Sdk="Microsoft.NET.Sdk">
  <!-- Krok 10B: společné nastavení všech služeb (Web, Inventory.Api) – health checky, service discovery, odolnost HTTP.
       Obdoba šablony Aspire "ServiceDefaults"; OpenTelemetry přibude v kroku 11 (observabilita). -->
  <PropertyGroup>
    <IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>
</Project>
