#!/bin/bash
# Cloud krok 9: příprava nové VM – automaticky totéž, co se v krocích 4, 5 a 8 dělalo ručně.
# Spouští ho cloud-init jednou při prvním startu (jako root). Log: /var/log/minishop-bootstrap.log
#
# Je to šablona OpenTofu (templatefile): hodnoty v dolar-složených závorkách doplní OpenTofu.
# Proto v bashi níže jen $promenna bez závorek – jinak by je OpenTofu bral jako své.
set -euo pipefail
exec > >(tee -a /var/log/minishop-bootstrap.log) 2>&1

APP_DIR=/opt/minishop

step() { echo; echo "=== [$(date -u +%FT%TZ)] $* ==="; }

step "1/5 iptables: 80 a 443 (krok 4 E2)"
# Oraclův obraz Ubuntu odmítá vše kromě SSH pravidlem REJECT na konci INPUT. Povolení vložíme PŘED něj
# a uložíme – ještě před instalací Dockeru, aby se do souboru neuložila i jeho dočasná pravidla.
reject=$(iptables -L INPUT -n --line-numbers | awk '$2 == "REJECT" {print $1; exit}')
if [ -n "$reject" ]; then
    iptables -I INPUT "$reject" -m state --state NEW -p tcp --dport 443 -j ACCEPT
    iptables -I INPUT "$reject" -m state --state NEW -p tcp --dport 80 -j ACCEPT
    netfilter-persistent save
else
    echo "Pravidlo REJECT nenalezeno – iptables beze změny."
fi
iptables -L INPUT -n --line-numbers

step "2/5 Docker (krok 4 E3)"
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu
docker version --format 'Docker {{.Server.Version}} ({{.Server.Arch}})'
docker compose version

step "3/5 Tailscale (krok 8 C1)"
# Auth key nahrazuje ruční přihlášení odkazem. Je jednorázový a s tagem – po použití je bezcenný.
curl -fsSL https://tailscale.com/install.sh | sh
tailscale up --auth-key='${tailscale_auth_key}' --hostname=minishop-vm \
    --advertise-tags=tag:minishop-vm --accept-dns=false
echo "Tailscale IP: $(tailscale ip -4)"

step "4/5 Uživatel deploy s vynuceným příkazem (krok 8 D1, D3)"
useradd --create-home --shell /bin/bash --groups docker deploy
install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
# Klíč GitHub Actions smí spustit jen minishop-deploy (ten z cloud-init/write_files).
echo 'restrict,command="/usr/local/bin/minishop-deploy" ${deploy_ssh_public_key}' > /home/deploy/.ssh/authorized_keys
chown deploy:deploy /home/deploy/.ssh/authorized_keys
chmod 600 /home/deploy/.ssh/authorized_keys

step "5/5 Složka aplikace $APP_DIR"
# Krok 10: VM nedostane žádné secrets aplikace. Konfiguraci (deploy/production.env), .env i první start
# udělá až první nasazení z GitHubu: Actions → Deploy → Run workflow (secrets z environmentu production).
install -d -m 755 -o deploy -g deploy "$APP_DIR"

step "Hotovo – MiniShop nasadí první běh workflow Deploy"
