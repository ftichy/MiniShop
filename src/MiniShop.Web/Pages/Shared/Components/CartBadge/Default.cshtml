@model int
@* E-shop krok 3: počet kusů v košíku (CartBadgeViewComponent). *@
<li class="nav-item">
    <a class="nav-link" asp-page="/Cart/Index" data-track="nav-cart">
        Košík
        @if (Model > 0)
        {
            <span class="badge bg-primary ms-1">@Model</span>
        }
    </a>
</li>
