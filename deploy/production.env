# Cloud krok 10: NETAJNÁ konfigurace produkce (VM v cloudu). Změna = PR → po sloučení ji nasadí CD.
# Z tohoto souboru, štítku image a secrets z GitHubu (environment production) sestaví deploy.sh na VM soubor .env.
# Nic tajného sem nepatří – repozitář je veřejný. Tajné hodnoty: RABBITMQ_PASSWORD, BASIC_AUTH_HASH, SMTP_PASSWORD,
# INVENTORY_API_KEY (viz docs/secrets.md).

# Compose na VM čte i doplněk s Caddy (HTTPS + zámek), viz compose.cloud.yaml.
COMPOSE_FILE=compose.yaml:compose.cloud.yaml

# Image z registry (krok 7). IMAGE_TAG=sha-… doplní deploy.sh podle nasazovaného commitu.
IMAGE_PREFIX=ghcr.io/ftichy/

# Doména pro certifikát Let's Encrypt (krok 5).
DOMAIN=minishop-tichy.duckdns.org

# Zámek před aplikací (krok 5). Účty krok 9: off – web je veřejný, chrání ho vlastní přihlašování a role.
# Aspire dashboard má zámek vždy (Caddyfile), proto BASIC_AUTH_USER a secret BASIC_AUTH_HASH zůstávají.
BASIC_AUTH=off
BASIC_AUTH_USER=minishop

# Účet do RabbitMQ (heslo je secret). Jméno se po prvním startu už nemění – vznikl s ním volume.
RABBITMQ_USER=minishop

# Účty krok 5: e-maily přes Gmail (heslo aplikace je secret SMTP_PASSWORD). Odesílatel = účet, jinak ho Gmail přepíše.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=ftichy.gemini@gmail.com
EMAIL_FROM_ADDRESS=ftichy.gemini@gmail.com
