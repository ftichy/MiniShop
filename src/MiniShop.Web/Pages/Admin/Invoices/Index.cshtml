@page
@model MiniShop.Web.Pages.Admin.Invoices.IndexModel
@{
    ViewData["Title"] = "Faktury";
    var czech = System.Globalization.CultureInfo.GetCultureInfo("cs-CZ");
}
<partial name="_AdminHeader" model='new MiniShop.Web.Ui.AdminHeaderModel("Faktury")' />
<p class="text-muted">
    Vystavené faktury (modul Invoicing) – po zaplacení kartou, u dobírky po doručení. Faktura se nemění ani nemaže;
    zrušení, zamítnutí nebo vrácení zaplacené objednávky vystaví automaticky dobropis (řada <code>D…</code>).
</p>

@if (Model.Invoices.Count == 0)
{
    <p class="text-muted">Zatím žádná faktura.</p>
}
else
{
    <div class="table-responsive admin-table"><table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Číslo</th>
                <th>Vystavena</th>
                <th>Odběratel</th>
                <th class="text-end">Částka</th>
                <th>Objednávka</th>
                <th></th>
                <th>Dobropis</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var invoice in Model.Invoices)
            {
                <tr>
                    <td>@invoice.Number</td>
                    <td>@invoice.IssuedAtUtc.ToLocalTime().ToString("g", czech)</td>
                    <td>@invoice.CustomerName</td>
                    <td class="text-end">@invoice.Total.ToString("N2", czech) Kč</td>
                    <td><a asp-page="/Orders/Detail" asp-route-id="@invoice.OrderId">č. @invoice.OrderId</a></td>
                    <td><a asp-page="/Orders/Invoice" asp-route-id="@invoice.OrderId" data-track="admin-invoice-pdf">PDF</a></td>
                    <td>
                        @if (invoice.CreditNoteNumber is not null)
                        {
                            @* E-shop krok 15B *@
                            <a asp-page="/Orders/CreditNote" asp-route-id="@invoice.OrderId" data-track="admin-credit-note-pdf">@invoice.CreditNoteNumber</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
